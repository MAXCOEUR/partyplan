# PartyPlan — variables de développement local
# Copier en `.env` à la racine. Pour la production, voir infra/compose/.env.example.
# Toute variable lue par le code doit figurer ici — RG-DEV-02.

# ---------- PostgreSQL ----------
POSTGRES_DB=partyplan
POSTGRES_USER=partyplan
POSTGRES_PASSWORD=partyplan

# ---------- Ports publiés sur l'hôte ----------
# 5433 et non 5432 : le port standard est souvent déjà pris par un autre projet.
DB_PORT=5433
API_PORT=5080
WEB_PORT=8080
LANDING_PORT=8081
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5433;Database=partyplan;Username=partyplan;Password=partyplan

# ---------- Authentification ----------
# Clé de développement, sans valeur secrète. RG-DEV-01 la refuse en production.
JWT_SIGNING_KEY=cle_de_developpement_non_secrete_32c

# ---------- Compte administrateur amorcé — RG-ADM-09 ----------
# Identifiants de développement, volontairement connus et documentés.
# RG-ADM-11 refuse le démarrage en production avec ces valeurs.
ADMIN_EMAIL=admin@partyplan.local
ADMIN_PASSWORD=MotDePasseDeDeveloppement

# ---------- Connexions tierces — NF-DEV-05 ----------
# Laisser vide : l'inscription et la connexion par mot de passe fonctionnent sans.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ---------- Notifications poussées — NF-DEV-04 ----------
# Vide : les notifications sont journalisées en console au lieu d'être envoyées.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------- Jeu de données de démonstration — NF-DEV-07 ----------
SEED_DEMO=true
