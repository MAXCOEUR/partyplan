# PartyPlan — variables de la pile de production
# Copier en `.env` dans ce répertoire, puis renseigner. Ce fichier ne doit jamais
# contenir de valeur réelle : `.env` est exclu du dépôt.

# ---------- Images publiées par l'intégration continue ----------
GHCR_OWNER=maxcoeur
API_TAG=latest
APP_TAG=latest
LANDING_TAG=latest

# ---------- Domaines ----------
DOMAIN_APP=partyplan.maxencecoeur.fr
DOMAIN_API=api.partyplan.maxencecoeur.fr
DOMAIN_CDN=cdn.partyplan.maxencecoeur.fr
DOMAIN_LANDING=www.maxencecoeur.fr
ACME_EMAIL=

# ---------- PostgreSQL ----------
POSTGRES_DB=partyplan
POSTGRES_USER=partyplan
POSTGRES_PASSWORD=

# ---------- Authentification ----------
# 32 octets minimum : openssl rand -base64 48
JWT_SIGNING_KEY=

# ---------- Chiffrement des secrets stockés ----------
# Obligatoire : sans elle, les secrets de double authentification ne peuvent pas être
# chiffrés et l'API refuse de démarrer. Doit différer de JWT_SIGNING_KEY.
# Génération : openssl rand -base64 32
SECURITY_ENCRYPTION_KEY=

# ---------- Compte administrateur amorcé — RG-ADM-09 ----------
# Obligatoire au premier démarrage. L'API refuse de démarrer si le mot de passe est
# absent alors qu'aucun administrateur n'existe, ou s'il fait moins de 12 caractères
# (RG-ADM-11). Ce mot de passe doit être changé à la première connexion (RG-ADM-10),
# après quoi la variable peut être retirée (RG-ADM-12).
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ---------- Courriel transactionnel ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PartyPlan <bonjour@partyplan.maxencecoeur.fr>

# ---------- Limitation de débit ----------
# Valeurs par défaut du code. À ajuster selon le trafic réel observé (NF-SEC-11).
RATE_LIMITING_ENABLED=true

# ---------- Notifications poussées ----------
# Contenu JSON du compte de service Firebase, sur une seule ligne.
FIREBASE_SERVICE_ACCOUNT_JSON=
