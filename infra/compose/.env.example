# PartyPlan — variables de la pile de production
# Copier en `.env` dans ce répertoire, puis renseigner. Ce fichier ne doit jamais
# contenir de valeur réelle : `.env` est exclu du dépôt.

# ---------- Images publiées par l'intégration continue ----------
GHCR_OWNER=maxcoeur
API_TAG=latest
APP_TAG=latest
LANDING_TAG=latest

# ---------- Domaines ----------
DOMAIN_APP=partyplan.maxencecoeur.fr
DOMAIN_API=api.partyplan.maxencecoeur.fr
DOMAIN_CDN=cdn.partyplan.maxencecoeur.fr
DOMAIN_LANDING=www.maxencecoeur.fr
ACME_EMAIL=

# ---------- PostgreSQL ----------
POSTGRES_DB=partyplan
POSTGRES_USER=partyplan
POSTGRES_PASSWORD=

# ---------- Authentification ----------
# 32 octets minimum : openssl rand -base64 48
JWT_SIGNING_KEY=

# ---------- Compte administrateur amorcé — RG-ADM-09 ----------
# Obligatoire au premier démarrage. L'API refuse de démarrer si le mot de passe est
# absent alors qu'aucun administrateur n'existe, ou s'il fait moins de 12 caractères
# (RG-ADM-11). Ce mot de passe doit être changé à la première connexion (RG-ADM-10),
# après quoi la variable peut être retirée (RG-ADM-12).
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ---------- Courriel transactionnel ----------
# Relais de courriel du déploiement. En développement, ces valeurs ne servent
# pas : le compose local écrit Mailpit en dur (NF-DEV-03).
#
# Pour Brevo : SMTP_HOST=smtp-relay.brevo.com, port 587, identifiant de la forme
# xxxxxxx@smtp-brevo.com, clé SMTP en mot de passe. Brevo refuse le relais depuis
# une adresse IP non autorisée dans le compte (Paramètres → SMTP & API → IP
# autorisées) : la réponse est « 525 Unauthorized IP address ».
#
# Les mêmes identifiants, préfixés BREVO_, alimentent la surcharge
# compose.mail-reel.yml pour un essai d'envoi réel depuis un poste local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# L'expéditeur doit être un domaine ou une adresse validés chez le relais, sinon
# le message est accepté puis jeté sans arriver.
SMTP_FROM=PartyPlan <bonjour@partyplan.maxencecoeur.fr>

# ---------- Limitation de débit ----------
# Valeurs par défaut du code. À ajuster selon le trafic réel observé (NF-SEC-11).
RATE_LIMITING_ENABLED=true

# ---------- Notifications poussées ----------
# Chemin du fichier de clé de compte de service Firebase. Vide en développement :
# les notifications sont alors journalisées. Voir docs/comptes-externes.md.
FIREBASE_SERVICE_ACCOUNT_PATH=
