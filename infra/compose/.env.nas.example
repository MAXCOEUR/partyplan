# PartyPlan — variables de la pile NAS
#
# Copier ce fichier en `.env` **dans le même répertoire que compose.nas.yml** sur
# le NAS, puis renseigner. Le nom `.env` est imposé par Docker Compose : un
# fichier nommé autrement est ignoré sans message, et le démarrage échouera sur
# les variables obligatoires.
#
# Ce fichier ne doit jamais contenir de valeur réelle : `.env` et `.env.*` sont
# exclus du dépôt, seul `.env.example` et `.env.nas.example` y figurent.

# ---------- Images publiées par l'intégration continue ----------
GHCR_OWNER=maxcoeur
API_TAG=latest
APP_TAG=latest
LANDING_TAG=latest

# ---------- Domaines ----------
# L'application web porte le sous-domaine : elle sert /join/{jeton} et
# assetlinks.json. La vitrine, statique et indexable, prend le domaine racine.
DOMAIN_APP=web.partyplan.maxencecoeur.fr
DOMAIN_API=api.partyplan.maxencecoeur.fr
DOMAIN_CDN=cdn.partyplan.maxencecoeur.fr
DOMAIN_LANDING=partyplan.maxencecoeur.fr

# ---------- Ports publiés, que Nginx Proxy Manager va chercher ----------
LANDING_PORT=1000
API_PORT=1001
CDN_PORT=1002
WEB_PORT=1003

# ---------- Emplacement des données ----------
# Dossier contenant `db/`, `media/` et `sauvegardes/`. Relatif au répertoire du
# fichier compose, ou chemin absolu vers un dossier partagé du NAS déjà
# synchronisé vers l'extérieur — une sauvegarde restée sur la machine ne protège
# pas de sa perte.
DATA_PATH=./donnees

# ---------- PostgreSQL ----------
# Obligatoire. Sans valeur, le démarrage est refusé plutôt que de lancer une
# base sans mot de passe.
#   openssl rand -base64 24
POSTGRES_DB=partyplan
POSTGRES_USER=partyplan
POSTGRES_PASSWORD=

# ---------- Authentification ----------
# Obligatoire, 32 caractères minimum.
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# ---------- Administrateur amorcé — RG-ADM-09 à RG-ADM-12 ----------
# Obligatoires au premier démarrage. Douze caractères minimum pour le mot de
# passe, sinon refus de démarrer (RG-ADM-11). Il devra être changé dès la
# première connexion (RG-ADM-10), après quoi ADMIN_PASSWORD peut être vidé et la
# pile redéployée (RG-ADM-12).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Courriel transactionnel ----------
# Le seul service externe réellement nécessaire : sans lui, aucun lien de
# vérification d'adresse ni de réinitialisation ne part, et un compte créé reste
# non vérifié. L'API démarre quand même.
#
# Pour Brevo : SMTP_HOST=smtp-relay.brevo.com, port 587, identifiant de la forme
# xxxxxxx@smtp-brevo.com, clé SMTP en mot de passe. Brevo refuse le relais depuis
# une adresse IP non autorisée dans le compte (Paramètres → SMTP & API → IP
# autorisées) : penser à y déclarer l'adresse publique du NAS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PartyPlan <bonjour@partyplan.maxencecoeur.fr>

# ---------- Connexion Google ----------
# Vides, l'instance fonctionne : aucun bouton Google n'apparaît et l'inscription
# par mot de passe suffit (NF-DEV-05).
#
# GOOGLE_CLIENT_ID est celui du client **Application Web** de la console Google
# Cloud, y compris pour Android : le jeton émis porte cette audience.
#
# Attention : côté navigateur, l'identifiant est inscrit dans le JavaScript à la
# compilation de l'image. Le renseigner ici ne fait accepter le jeton par l'API,
# il ne fait pas apparaître le bouton. Voir docs/comptes-externes.md §1.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ---------- Notifications poussées ----------
# Vide : les notifications sont journalisées et rien ne part (NF-DEV-04).
# Pour les activer, déposer la clé dans `secrets/firebase.json` à côté du compose
# — par scp, jamais par git : elle est hors dépôt — et mettre ici
# /run/secrets/firebase.json. Le montage du répertoire est déjà en place.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---------- Limitation de débit ----------
RATE_LIMITING_ENABLED=true
