         c'est-à-dire pour « make migration » et « make migrate ». PrivateAssets :
         l'outillage ne part pas en production. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>

</Project>
